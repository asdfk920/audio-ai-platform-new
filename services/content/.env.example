# 阿里云 RAM（填入后改名为 .env 放在 services/content/ 或与 yaml 同级 etc/.env，勿提交仓库）
CONTENT_OSS_ACCESS_KEY_ID=
CONTENT_OSS_ACCESS_KEY_SECRET=
#
# OSS 域名/bucket/driver 可由后台 sys_config（upload_storage_*）维护；需在 content.yaml 开启 Storage.SyncFromSysConfig；
# 同一字段若以本文件或进程的 CONTENT_* / OSS_* 环境变量赋值，仍会覆盖库里配置。
#
# 若与 YAML/sys_config 一致可省略：
# CONTENT_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# CONTENT_OSS_BUCKET=220aaa
