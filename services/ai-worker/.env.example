# ============================================
# AI Worker Service - 环境变量配置
# ============================================

# 服务配置
SERVICE_NAME=ai-worker
LOG_LEVEL=info
PORT=8004

# JWT 认证
JWT_SECRET=audio-ai-platform-user-secret

# GPU 配置
GPU_DEVICE=0
CUDA_VISIBLE_DEVICES=0

# 模型配置
MODEL_BASE_DIR=/app/models
OUTPUT_DIR=/app/output
CACHE_DIR=/app/cache
DEFAULT_MODEL=htdemucs

# 推理参数
MAX_CONCURRENT_JOBS=3
SEGMENT_SIZE=10
OVERLAP=0.25
USE_FP16=true
BATCH_SIZE=1

# Docker 镜像仓库 (可选)
DOCKER_REGISTRY=
IMAGE_TAG=v1.0.0

# K8s 部署配置
DEPLOY_TO_K8S=false
KUBE_NAMESPACE=audio-ai-platform

# 监控配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_URL=http://grafana:3000