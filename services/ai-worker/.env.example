# ===========================================
# AI Worker Service - 环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际情况填写以下配置
# 3. .env 文件已加入 .gitignore，不会被提交到 Git
# ===========================================

# 服务配置
SERVICE_NAME=ai-worker
LOG_LEVEL=info
PORT=8004

# ===========================================
# PostgreSQL 数据库连接信息
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=admin123
DB_NAME=audio_platform

# ===========================================
# Redis 连接信息
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# ===========================================
# JWT 认证密钥（必须与 User 服务一致）
# ===========================================
JWT_SECRET=audio-ai-platform-user-secret

# ===========================================
# 对象存储配置 (阿里云 OSS) ⚠️ 敏感信息
# ===========================================
# 存储驱动: oss | s3 | local
STORAGE_DRIVER=oss

# 阿里云 OSS 配置
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY=your_access_key_here
OSS_SECRET_KEY=your_secret_key_here
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-beijing

# S3 兼容存储配置 (可选)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# 本地存储配置 (当 STORAGE_DRIVER=local 时使用)
LOCAL_STORAGE_ROOT=./data/ai-worker-objects

# 公网访问 URL 前缀（用于生成下载链接）
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ===========================================
# SQS 队列配置 (可选)
# ===========================================
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:4566/000000000000/ai-inference-queue
SQS_ACCESS_KEY=
SQS_SECRET_KEY=

# ===========================================
# AI 模型配置
# ===========================================
GPU_DEVICE=-1
CUDA_VISIBLE_DEVICES=
MODEL_BASE_DIR=./models
OUTPUT_DIR=./output
CACHE_DIR=./cache
DEFAULT_MODEL=bsroformer

# 推理参数
MAX_CONCURRENT_JOBS=2
SEGMENT_SIZE=10
OVERLAP=0.25
USE_FP16=false
USE_INT8=false
BATCH_SIZE=1

# ===========================================
# 回调配置
# ===========================================
CALLBACK_TIMEOUT_SEC=30
CALLBACK_RETRY_COUNT=3

# ===========================================
# Docker/K8s 部署配置 (可选)
# ===========================================
DOCKER_REGISTRY=
IMAGE_TAG=v1.0.0
DEPLOY_TO_K8S=false
KUBE_NAMESPACE=audio-ai-platform

# ===========================================
# 监控配置 (可选)
# ===========================================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_URL=http://grafana:3000
