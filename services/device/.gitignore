# ===========================================
# Git 忽略规则 - 敏感信息保护
# ===========================================

# 环境变量文件（包含密码、密钥等敏感信息）
.env
.env.local
.env.*.local

# YAML 配置文件（可能包含数据库密码、API密钥）
etc/*.yaml
!etc/*.example.yaml

# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
device.exe

# 测试覆盖率文件
coverage.out
coverage.html

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# IDE 配置文件
.idea/
.vscode/
*.iml

# 日志文件
*.log
logs/
debug-*.log

# 操作系统文件
.DS_Store
Thumbs.db

# Go 工作区
vendor/
