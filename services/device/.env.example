# ===========================================
# 设备微服务环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际情况填写以下配置
# 3. .env 文件已加入 .gitignore，不会被提交到 Git
#
# 注意：此文件只包含敏感信息，其他配置仍在 etc/device.yaml 中

# PostgreSQL 数据库连接信息
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASS=admin123
POSTGRES_DB=audio_platform
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=Asia/Shanghai

# Redis 连接信息
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=
REDIS_DB=0

# JWT 认证密钥（用户端）
AUTH_ACCESS_SECRET=audio-ai-platform-user-secret
AUTH_ACCESS_EXPIRE=3600

# 设备认证密钥
DEVICE_AUTH_TOKEN_SECRET=audio-ai-platform-device-secret
DEVICE_AUTH_TOKEN_EXPIRE_SECONDS=86400
DEVICE_AUTH_TIMESTAMP_TOLERANCE_SECOND=300

# MQTT Broker 配置（设备注册用）
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=device-api-mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# HTTP 服务基础地址
HTTP_BASE_URL=http://localhost:8002

# 日志配置
LOG_LEVEL=info
LOG_MODE=console
